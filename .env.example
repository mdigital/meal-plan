# Copy to .env for local dev (tsx loads it via --env-file), or set as Fly secrets in production.
APP_URL=http://localhost:3000
ALLOWED_EMAILS=robin@mdigital.co.nz:Robin,partner@example.com:Partner
DATABASE_PATH=./data/meals.db
# Email: leave SES_REGION unset locally and links are printed to the console.
# SES_REGION=ap-southeast-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# EMAIL_FROM=Meals <meals@example.com>
# ANTHROPIC_API_KEY=
# AI_DAILY_CAP=20
# BACKUP_EMAIL=robin@mdigital.co.nz   # nightly backup recipient; "off" to disable
